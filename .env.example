# PostgreSQL settings used by Docker Compose.
POSTGRES_DB=razorpay_black_box
POSTGRES_USER=razorpay
POSTGRES_PASSWORD=change-me-for-local-development
POSTGRES_PORT=5432

# Backend runtime settings. Docker Compose supplies DATABASE_URL using the
# internal postgres service hostname. Use a host-local URL when running the
# backend outside Docker.
APP_ENV=development
BACKEND_PORT=8000
DATABASE_URL=postgresql+psycopg://razorpay:change-me-for-local-development@localhost:5432/razorpay_black_box
TEST_DATABASE_URL=postgresql+psycopg://razorpay:change-me-for-local-development@localhost:5432/razorpay_black_box_test

# Frontend development server port.
FRONTEND_PORT=5173

# Reserved for a future agent/investigator phase. Do not commit a real key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.2
OPENAI_CONFIDENCE_THRESHOLD=0.7
